{
	"name": "svelte-kit-bun",
	"version": "0.7.0-next.0",
	"description": "Experimental adapter for SvelteKit apps that compiles to a Bun single-file executable",
	"keywords": [
		"adapter",
		"bun",
		"executable",
		"svelte",
		"sveltekit",
		"single-file-executable"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mastermakrela/svelte-kit-bun.git"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "index.d.ts",
	"files": [
		"files",
		"src",
		"index.js",
		"index.d.ts",
		"ambient.d.ts"
	],
	"workspaces": [
		"tests/fixtures/*"
	],
	"scripts": {
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:watch": "vitest",
		"check": "tsc",
		"lint": "oxlint && oxfmt --check .",
		"format": "oxfmt --write ."
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.0.0-next.27",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.2",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.1"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0-next.27"
	},
	"dependencies": {
		"resedit": "^3.1.0"
	}
}
